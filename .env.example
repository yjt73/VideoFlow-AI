# 前端与 API 同域时留空；跨域部署时填写后端地址
VITE_API_BASE_URL=

# 数据库
DB_URL=jdbc:mysql://localhost:13306/media_db?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf-8&allowPublicKeyRetrieval=true
DB_USERNAME=videoflow
DB_PASSWORD=replace_me
MYSQL_APP_USER=videoflow
MYSQL_ROOT_PASSWORD=replace_with_a_different_root_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=replace_me
REDIS_DATABASE=0

# MinIO
MINIO_ENDPOINT=http://localhost:19000
MINIO_ACCESS_KEY=replace_me
MINIO_SECRET_KEY=replace_me
MINIO_BUCKET=media

# RocketMQ
ROCKETMQ_NAME_SERVER=127.0.0.1:19876
ROCKETMQ_ANALYSIS_TOPIC=videoflow-ai-analysis-topic
ROCKETMQ_ANALYSIS_DEAD_TOPIC=videoflow-ai-analysis-dead-topic
ROCKETMQ_CONSUMER_GROUP=videoflow-ai-analysis-group

# Qdrant
QDRANT_URL=http://localhost:16333
QDRANT_API_KEY=replace_me
QDRANT_COLLECTION=videoflow_ai_chunks

# AI 服务
AI_API_KEY=replace_me
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_CHAT_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-32B
AI_CHAT_TIMEOUT_SECONDS=300
AI_EMBEDDING_MODEL=BAAI/bge-m3

# 两轮 Agent 分析的最长执行时间（毫秒）
AGENT_MAX_DURATION_MS=300000

# JWT（至少 32 字节）
JWT_SECRET=replace_with_at_least_32_bytes
JWT_EXPIRATION_SECONDS=7200

# 本地工具
YTDLP_PATH=yt-dlp
FFMPEG_DIR=
OCR_COMMAND=tesseract
